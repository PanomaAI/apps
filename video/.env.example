# Copy to .env — never commit the real one. Every generator reads these.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# The brain (optional). Without any of these, the claude or codex CLI on PATH is used; with none, the templates write every word.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# PANOMA_VIDEO_BRAIN=auto|none|claude|codex|anthropic|openai · PANOMA_VIDEO_BRAIN_MODEL=<model id or alias> · PANOMA_VIDEO_MAX_BRAIN_CALLS=24
# To use the signed-in Codex CLI explicitly, start with Luna:
# PANOMA_VIDEO_BRAIN=codex
# PANOMA_VIDEO_BRAIN_MODEL=gpt-5.6-luna
# Compare gpt-5.6-terra on the same recorded evidence if editorial quality needs it.
# These settings belong to panoma video; they do not change Codex's own default model.

# Video generation. GEMINI_API_KEY buys Veo 3.1 and Gemini Omni Flash; a key alone is not
# enough — the account needs prepayment credit, and an account without it answers 429 on
# generation while answering 200 on everything free. FAL_KEY buys Seedance 2.0 (and it is
# the only provider of the three that makes a SQUARE clip, which the engine cuts for the feed).
# PANOMA_VIDEO_SEEDANCE_PER_SECOND is your own rate: fal publishes none on its reference page, and
# a price this repository invented would be worse than an absent one.
FAL_KEY=
PANOMA_VIDEO_SEEDANCE_PER_SECOND=
